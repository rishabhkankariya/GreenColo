# GreenColo Environment Configuration

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# InfluxDB v2 (Time-Series Telemetry)
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_LOCAL_URL=http://localhost:8086
INFLUXDB_TOKEN=greencolo-super-secret-admin-token-2026
INFLUXDB_ORG=greencolo
INFLUXDB_BUCKET=greencolo_telemetry

# PostgreSQL (Structured metadata & placement logs)
POSTGRES_HOST=postgres
POSTGRES_LOCAL_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=greencolo_db
POSTGRES_USER=greencolo_admin
POSTGRES_PASSWORD=greencolo_secure_pass_2026

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000

# Electricity Maps API
ELECTRICITY_MAPS_API_KEY=mock_key_or_insert_token_here
ELECTRICITY_MAPS_ZONE=IN-WE
USE_MOCK_CARBON=true

# Regional Electricity Tariff (INR / kWh) - MSEDCL Baseline
DEFAULT_TARIFF_INR_PER_KWH=11.50
